rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfileImage(fileName) {
      return fileName.matches('^avatar_[0-9]+[.](jpg|png)$')
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$');
    }

    match /secret_chat_profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && validProfileImage(fileName);
      allow update: if isOwner(userId) && validProfileImage(fileName);
      allow delete: if isOwner(userId);
    }

    // Task #10: confidential counselor interview files, scoped to currently
    // assigned-college counselors (verified students) or the configured super-admin.
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function effectiveRole() {
      return userDoc().get('accessRole', userDoc().get('role', 'appUser'));
    }

    function hasActiveClinicalLifecycle() {
      return signedIn()
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && userDoc().get('accountStatus', 'active') == 'active'
        && (
          effectiveRole() == 'admin'
          || userDoc().get('staffAccountStatus', null) == null
          || userDoc().get('staffAccountStatus', null) == 'approved'
        );
    }

    function isSystemAdmin() {
      return hasActiveClinicalLifecycle()
        && effectiveRole() == 'admin'
        && firestore.exists(/databases/(default)/documents/system_config/security)
        && request.auth.uid == firestore.get(/databases/(default)/documents/system_config/security).data.superAdminUid;
    }

    function appointmentRecordExists(appointmentId) {
      return firestore.exists(/databases/(default)/documents/appointments/$(appointmentId));
    }

    function appointmentStudentId(appointmentId) {
      return firestore.get(/databases/(default)/documents/appointments/$(appointmentId)).data.get('userId', '');
    }

    function isLiveAssignedCollegeCounselor(studentId) {
      return effectiveRole() == 'counselor'
        && hasActiveClinicalLifecycle()
        && studentId is string
        && studentId != ''
        && firestore.exists(/databases/(default)/documents/users/$(studentId))
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('verificationStatus', '') == 'verified'
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('collegeId', '') is string
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('collegeId', '') != ''
        && firestore.get(/databases/(default)/documents/users/$(studentId)).data.get('collegeId', '') in userDoc().get('assignedCollegeIds', []);
    }

    function canAccessAppointmentEvidence(appointmentId) {
      return appointmentRecordExists(appointmentId)
        && (isSystemAdmin() || isLiveAssignedCollegeCounselor(appointmentStudentId(appointmentId)));
    }

    match /counseling_session_files/{appointmentId}/{uploaderUid}/{fileName} {
      allow get: if canAccessAppointmentEvidence(appointmentId);
      allow list: if false;
      allow create: if canAccessAppointmentEvidence(appointmentId)
        && request.auth.uid == uploaderUid
        && firestore.get(/databases/(default)/documents/appointments/$(appointmentId)).data.status == 'confirmed'
        && fileName.matches('^[a-f0-9]{32}[.](jpg|jpeg|png|pdf|doc|docx)$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ]
        && request.resource.metadata.uploadedBy == uploaderUid
        && request.resource.metadata.appointmentId == appointmentId;
      allow delete: if canAccessAppointmentEvidence(appointmentId)
        && request.auth.uid == uploaderUid
        && firestore.get(/databases/(default)/documents/appointments/$(appointmentId)).data.status == 'confirmed';
      allow update: if false;
    }

    match /profile_images/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && fileName.matches('^avatar[.](jpg|png)$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$');
      allow delete: if isOwner(userId);
    }
  }
}

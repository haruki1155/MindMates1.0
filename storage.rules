rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfileImage(fileName) {
      return fileName.matches('^avatar_[0-9]+[.](jpg|png)$')
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$');
    }

    match /secret_chat_profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && validProfileImage(fileName);
      allow update: if isOwner(userId) && validProfileImage(fileName);
      allow delete: if isOwner(userId);
    }

    // Task #10: authenticated, approved clinicians only. This path never
    // exposes download tokens or permits listing the clinical file namespace.
    function isVerifiedClinician() {
      return signedIn()
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accessRole',
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'appUser')) in ['counselor', 'admin']
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accessRole', 'appUser') == 'admin'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('staffAccountStatus', null) == null
          || (
            firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('staffAccountStatus', '') == 'approved'
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('accountStatus', '') == 'active'
          )
        );
    }

    function appointmentRecordExists(appointmentId) {
      return firestore.exists(/databases/(default)/documents/appointments/$(appointmentId));
    }

    match /counseling_session_files/{appointmentId}/{uploaderUid}/{fileName} {
      // These files contain counseling interview information. Students and
      // generic portal staff can never read them.
      allow get: if isVerifiedClinician() && appointmentRecordExists(appointmentId);
      allow list: if false;
      // Upload is allowed only while a scheduled session is confirmed.
      allow create: if isVerifiedClinician()
        && request.auth.uid == uploaderUid
        && appointmentRecordExists(appointmentId)
        && firestore.get(/databases/(default)/documents/appointments/$(appointmentId)).data.status == 'confirmed'
        && fileName.matches('^[a-f0-9]{32}[.](jpg|jpeg|png|pdf|doc|docx)
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && fileName.matches('^avatar[.](jpg|png)$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$');
      allow delete: if isOwner(userId);
    }
  }
}
)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg', 'image/png', 'application/pdf', 'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ]
        && request.resource.metadata.uploadedBy == uploaderUid
        && request.resource.metadata.appointmentId == appointmentId;
      // May remove a draft upload before the appointment is finalized;
      // after completion, saved evidence cannot be edited or deleted by clients.
      allow delete: if isVerifiedClinician()
        && request.auth.uid == uploaderUid
        && appointmentRecordExists(appointmentId)
        && firestore.get(/databases/(default)/documents/appointments/$(appointmentId)).data.status == 'confirmed';
      allow update: if false;
    }

    match /profile_images/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && fileName.matches('^avatar[.](jpg|png)$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$');
      allow delete: if isOwner(userId);
    }
  }
}

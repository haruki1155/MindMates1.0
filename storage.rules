rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfileImage(fileName) {
      return fileName.matches('^avatar_[0-9]+[.](jpg|png)$')
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$');
    }

    match /secret_chat_profiles/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if isOwner(userId) && validProfileImage(fileName);
      allow update: if isOwner(userId) && validProfileImage(fileName);
      allow delete: if isOwner(userId);
    }

    // Only assigned counselors can remove draft clinical evidence.
    // Uploads and downloads use the private callables.
    function isVerifiedSignedIn() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userDocExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function effectiveRole() {
      return userDoc().get('accessRole', userDoc().get('role', 'appUser'));
    }

    function hasActiveClinicalAccount(expectedRole) {
      return isVerifiedSignedIn()
        && userDocExists()
        && effectiveRole() == expectedRole
        && userDoc().get('accountStatus', 'active') == 'active'
        && (
          expectedRole == 'admin'
          || userDoc().get('staffAccountStatus', null) == null
          || userDoc().get('staffAccountStatus', null) == 'approved'
        );
    }

    function appointmentExists(appointmentId) {
      return firestore.exists(/databases/(default)/documents/appointments/$(appointmentId));
    }

    function appointmentDoc(appointmentId) {
      return firestore.get(/databases/(default)/documents/appointments/$(appointmentId)).data;
    }

    function isAssignedCollegeCounselor(appointmentId) {
      return hasActiveClinicalAccount('counselor')
        && appointmentExists(appointmentId)
        && appointmentDoc(appointmentId).get('userId', '') is string
        && appointmentDoc(appointmentId).get('userId', '') != ''
        && appointmentDoc(appointmentId).get('studentVerificationStatus', '') == 'verified'
        && appointmentDoc(appointmentId).get('collegeId', '') is string
        && appointmentDoc(appointmentId).get('collegeId', '') != ''
        && userDoc().get('assignedCollegeIds', []) is list
        && appointmentDoc(appointmentId).get('collegeId', '') in userDoc().get('assignedCollegeIds', []);
    }

    match /counseling_session_files/{appointmentId}/{uploaderUid}/{fileName} {
      allow get: if false;
      allow list: if false;
      allow create: if false;
      allow delete: if isVerifiedSignedIn()
        && request.auth.uid == uploaderUid
        && isAssignedCollegeCounselor(appointmentId)
        && appointmentDoc(appointmentId).get('status', '') == 'confirmed';
      allow update: if false;
    }

    match /profile_images/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && fileName.matches('^avatar[.](jpg|png)$')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png)$');
      allow delete: if isOwner(userId);
    }
  }
}

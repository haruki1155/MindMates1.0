{
  "name": "mind-mates-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test lib/**/*.test.js",
    "test:rules": "npm run build && node --test lib/firestore_sleep_rules.rules.js lib/firebase_secret_chat_rules.rules.js",
    "test:profile-rules": "npm run build && node --test lib/profile_rules.rules.js",
    "profiles:dry-run": "npm run build && node lib/backfill_profiles.js",
    "profiles:apply": "npm run build && node lib/backfill_profiles.js --apply",
    "public-ids:dry-run": "npm run build && node lib/backfill_public_user_ids.js",
    "public-ids:apply": "npm run build && node lib/backfill_public_user_ids.js --apply",
    "admin:dry-run": "npm run build && node lib/provision_super_admin.js",
    "admin:provision": "npm run build && node lib/provision_super_admin.js --apply"
  },
  "dependencies": {
    "@google-cloud/dialogflow-cx": "^4.10.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.12",
    "firebase": "^12.16.0",
    "typescript": "^6.0.3"
  }
}

# Staging uses Gemini only when this value is deployed with the function.
MINDAID_AI_PROVIDER=gemini

# Dialogflow remains the resilience fallback. Use the staging agent values locally.
DIALOGFLOW_CX_AGENT_ID=YOUR_AGENT_ID
DIALOGFLOW_CX_LOCATION=asia-southeast1

# Mood V2: server-side staging-only rollout; Dev remains pilot-only.
MOOD_V2_STAGING_STUDENT_ROLLOUT_ENABLED=false
MOOD_V2_STAGING_PILOT_UIDS=

# Back-up Data (Phase 1): Firestore managed export. See docs/operations/firestore-backup-runbook.md.
# Bucket name without gs://. Unset = backups cannot be requested.
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30
# The daily scheduler is a no-op until this is true.
BACKUP_SCHEDULE_ENABLED=false
BACKUP_MANUAL_DAILY_LIMIT=3

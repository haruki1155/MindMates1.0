rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function currentAccessRole() {
      return !signedIn() || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? 'appUser'
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessRole != null
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessRole
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasPortalAccess() {
      return currentAccessRole() in ['portalStaff', 'counselor', 'admin']
        && isVerifiedEmail()
        && (
          // The guarded super-admin record predates the staff-request
          // lifecycle. It is Auth-verified and is not an applicant request.
          currentAccessRole() == 'admin'
          ||
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffAccountStatus == null
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffAccountStatus == 'approved'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
          )
        );
    }

    function hasClinicalAccess() {
      return currentAccessRole() in ['counselor', 'admin'];
    }

    function isAdmin() {
      return hasClinicalAccess();
    }

    // Clinical staff may review care data, but only administrator accounts
    // may change portal configuration and curated content.
    function isPortalAdmin() {
      return currentAccessRole() == 'admin';
    }

    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/system_config/security)
        && request.auth.uid == get(/databases/$(database)/documents/system_config/security).data.superAdminUid
        && currentAccessRole() == 'admin';
    }

    function validSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'firstName', 'middleName', 'lastName', 'phone', 'avatarAssetName',
        'profilePhotoUrl', 'profilePhotoPath', 'profileSetupCompleted',
        'updatedAt', 'lastActiveAt', 'lastActivityDateKey', 'activeDateKeys',
        'streakUpdatedAt', 'dayStreak', 'longestStreak',
        'quickAssessmentCompleted', 'quickAssessmentCompletedAt',
        'lastMoodDateKey'
      ])
      && (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['profileSetupCompleted'])
          || request.resource.data.profileSetupCompleted == true);
    }

    function isLegacyPrivileged() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'counselor'];
    }

    match /users/{userId} {
      // New profiles must be created by the Admin SDK callable so Student ID
      // reservation and profile creation remain one atomic transaction.
      allow create: if false;
      allow read: if isOwner(userId) || isSystemAdmin();
      allow update: if (isOwner(userId) && validSelfProfileUpdate());
      allow delete: if isSystemAdmin();
    }

    match /system_config/{documentId} {
      allow read: if signedIn() && documentId == 'security';
      allow write: if false;
    }

    match /colleges/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /departments/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /courses/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /employee_id_reservations/{recordId} {
      allow read, write: if false;
    }

    match /student_id_reservations/{recordId} {
      allow read, write: if false;
    }

    match /admin_audit_logs/{auditId} {
      allow read: if isSystemAdmin();
      allow write: if false;
    }

    match /user_public_ids/{userId} {
      allow read, write: if false;
    }

    match /public_user_id_reservations/{publicId} {
      allow read, write: if false;
    }

    match /assessments/{assessmentId} {
      allow create: if isVerifiedEmail() && isOwner(request.resource.data.userId)
        && (!request.resource.data.keys().hasAny(['schemaVersion'])
          || request.resource.data.schemaVersion != 'assessment_record_v4')
        && (request.resource.data.type != 'quick'
          || assessmentId == 'quick_' + request.auth.uid);
      allow get: if (signedIn()
          && assessmentId == 'quick_' + request.auth.uid)
        || isOwner(resource.data.userId)
        || isAdmin();
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin()
        || (isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && resource.data.type != 'quick'
          && (!resource.data.keys().hasAny(['schemaVersion'])
            || resource.data.schemaVersion != 'assessment_record_v4'));
    }

    match /assessment_feedback/{feedbackId} {
      allow create: if isVerifiedEmail() && signedIn()
        && request.resource.data.keys().hasOnly([
          'clarity', 'algorithmVersion', 'questionSetVersion', 'createdAt'
        ])
        && request.resource.data.clarity in ['clear', 'partlyClear', 'unclear']
        && request.resource.data.algorithmVersion is string
        && request.resource.data.questionSetVersion is string
        && request.resource.data.createdAt == request.time;
      allow read: if hasPortalAccess();
      allow update, delete: if false;
    }

    function validSecretChatCategories(data) {
      return data.categories is list
        && data.categories.size() >= 1
        && data.categories.size() <= 3
        && data.categories.toSet().size() == data.categories.size()
        && data.categories.toSet().hasOnly([
          'Mental Health', 'Anxiety', 'Stress', 'Gratitude', 'Self-care',
          'School Pressure', 'Support'
        ])
        && data.category == data.categories[0];
    }

    match /moods/{moodId} {
      allow create: if isOwner(request.resource.data.userId)
        && moodId.matches('^daily_' + request.auth.uid + '_[0-9]{8}$')
        && request.resource.data.keys().hasOnly([
          'userId', 'level', 'label', 'note', 'dateKey', 'timezone', 'createdAt',
          'entryMethod', 'expressionAssistUsed', 'expressionSuggestionAccepted',
          'expressionModelVersion'
        ])
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 5
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.timezone == 'Asia/Manila'
        && request.resource.data.createdAt == request.time
        && ((!request.resource.data.keys().hasAny([
              'entryMethod', 'expressionAssistUsed',
              'expressionSuggestionAccepted', 'expressionModelVersion'
            ]))
          || (request.resource.data.keys().hasAll([
                'entryMethod', 'expressionAssistUsed',
                'expressionSuggestionAccepted'
              ])
            && request.resource.data.entryMethod == 'expression_assisted'
            && request.resource.data.expressionAssistUsed == true
            && request.resource.data.expressionSuggestionAccepted is bool
            && (!request.resource.data.keys().hasAny(['expressionModelVersion'])
              || request.resource.data.expressionModelVersion
                == 'justinshenk_fer_tflite_v1')));
      allow get: if (signedIn()
          && moodId.matches('^daily_' + request.auth.uid + '_[0-9]{8}$'))
        || isOwner(resource.data.userId)
        || isAdmin();
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin()
        || (isOwner(resource.data.userId)
          && resource.data.timezone != 'Asia/Manila');
    }

    match /journals/{journalId} {
      allow create: if isVerifiedEmail() && isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /reports/{reportId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin()
        || (isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId);
    }

    match /admin_status_summaries/{userId} {
      allow read: if isAdmin();
      allow create, update: if isOwner(request.resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /user_activities/{activityId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      allow update: if (isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId) || isAdmin();
    }

    match /breathing_sessions/{sessionId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      allow update: if (isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId) || isAdmin();
    }

    match /mind_aid_messages/{messageId} {
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.sender in ['user', 'assistant']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1600
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() <= 64
        && request.resource.data.id == messageId
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 24
        && request.resource.data.source is string
        && request.resource.data.source in ['local', 'dialogflow', 'controlled_safety']
        && request.resource.data.confidence is number
        && request.resource.data.confidence >= 0
        && request.resource.data.confidence <= 1
        && (request.resource.data.sender == 'user'
          || request.resource.data.source == 'local');
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    function validSleepTags(data) {
      return data.contributorTags is list
        && data.contributorTags.size() <= 12
        && data.contributorTags.toSet().size() == data.contributorTags.size()
        && data.contributorTags.toSet().hasOnly([
          'late_caffeine', 'alcohol', 'nicotine', 'naps', 'exercise',
          'late_screens', 'stress', 'environment', 'late_meal',
          'schedule_change', 'illness_pain', 'medication'
        ])
        && data.concernTags is list
        && data.concernTags.size() <= 5
        && data.concernTags.toSet().size() == data.concernTags.size()
        && data.concernTags.toSet().hasOnly([
          'breathing_pauses_gasping', 'loud_snoring_tiredness',
          'dangerous_sleepiness', 'persistent_problems', 'worsening_symptoms'
        ]);
    }

    function validSleepEntry(data) {
      return data.keys().hasOnly([
          'userId', 'wakeDateKey', 'timezone', 'attemptedSleepAt',
          'sleepOnsetAt', 'finalWakeAt', 'outOfBedAt', 'awakeningCount',
          'awakeMinutes', 'napCount', 'napMinutes', 'restfulness',
          'daytimeSleepiness', 'perceivedQuality', 'contributorTags',
          'concernTags', 'createdAt', 'clientUpdatedAt', 'updatedAt'
        ])
        && data.wakeDateKey is string
        && data.wakeDateKey.matches('^[0-9]{8}$')
        && data.timezone == 'Asia/Manila'
        && data.attemptedSleepAt is timestamp
        && data.sleepOnsetAt is timestamp
        && data.finalWakeAt is timestamp
        && data.outOfBedAt is timestamp
        && data.attemptedSleepAt <= data.sleepOnsetAt
        && data.sleepOnsetAt <= data.finalWakeAt
        && data.finalWakeAt <= data.outOfBedAt
        && data.awakeningCount is int
        && data.awakeningCount >= 0 && data.awakeningCount <= 50
        && data.awakeMinutes is int
        && data.awakeMinutes >= 0 && data.awakeMinutes <= 1440
        && ((data.awakeningCount == 0 && data.awakeMinutes == 0)
          || (data.awakeningCount > 0 && data.awakeMinutes > 0))
        && data.napCount is int && data.napCount >= 0 && data.napCount <= 10
        && data.napMinutes is int && data.napMinutes >= 0 && data.napMinutes <= 720
        && data.restfulness is int && data.restfulness >= 1 && data.restfulness <= 5
        && data.daytimeSleepiness is int
        && data.daytimeSleepiness >= 1 && data.daytimeSleepiness <= 5
        && data.perceivedQuality is int
        && data.perceivedQuality >= 1 && data.perceivedQuality <= 5
        && data.createdAt is timestamp
        && data.clientUpdatedAt is timestamp
        && data.updatedAt == request.time
        && validSleepTags(data);
    }

    match /sleep_entries/{sleepId} {
      allow create: if isOwner(request.resource.data.userId)
        && sleepId == 'sleep_' + request.auth.uid + '_' + request.resource.data.wakeDateKey
        && validSleepEntry(request.resource.data);
      allow get, list: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.wakeDateKey == resource.data.wakeDateKey
        && request.resource.data.createdAt == resource.data.createdAt
        && sleepId == 'sleep_' + request.auth.uid + '_' + request.resource.data.wakeDateKey
        && validSleepEntry(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /sleep_preferences/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'consentVersion', 'cloudConsent', 'grantedAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.consentVersion == 'sleep-v1'
        && request.resource.data.cloudConsent == true
        && request.resource.data.grantedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    match /mind_aid_preferences/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.hasDecision is bool
        && request.resource.data.cloudConsent is bool
        && request.resource.data.personalizationEnabled is bool
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() >= 8
        && request.resource.data.conversationId.size() <= 64;
      allow delete: if isOwner(userId);
    }

    match /mind_aid_feedback/{feedbackId} {
      allow create, update: if isOwner(request.resource.data.userId)
        && request.resource.data.messageId is string
        && request.resource.data.helpful is bool;
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /mind_aid_analytics_daily/{dateKey} {
      allow read: if hasPortalAccess();
      allow write: if false;
    }

    match /mind_aid_config/{documentId} {
      allow read, write: if isPortalAdmin();
    }

    match /_mind_aid_events/{eventId} {
      allow read, write: if false;
    }

    match /_mind_aid_rate_limits/{userId} {
      allow read, write: if false;
    }

    match /secret_chats/{postId} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isAdmin());
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.isAnonymous == true
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.keys().hasOnly([
          'authorId', 'message', 'category', 'categories', 'createdAt',
          'updatedAt', 'likeCount', 'commentCount', 'readCount',
          'moderationStatus', 'safetyLabels', 'isAnonymous'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 8
        && request.resource.data.message.size() <= 500
        && request.resource.data.safetyLabels is list
        && validSecretChatCategories(request.resource.data)
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.readCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /secret_chat_comments/{commentId} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isAdmin());
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.isAnonymous == true
        && request.resource.data.moderationStatus == 'active'
        && request.resource.data.keys().hasOnly([
          'postId', 'authorId', 'message', 'createdAt', 'updatedAt',
          'moderationStatus', 'safetyLabels', 'isAnonymous'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 400
        && request.resource.data.safetyLabels is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId))
        && get(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId)).data.moderationStatus == 'active';
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /secret_chat_interactions/{interactionId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && interactionId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'liked', 'saved', 'readAt', 'updatedAt'
        ])
        && (!('liked' in request.resource.data) || request.resource.data.liked is bool)
        && (!('saved' in request.resource.data) || request.resource.data.saved is bool)
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId))
        && (!('readAt' in request.resource.data)
          || (request.resource.data.readAt == request.time
            && get(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId)).data.authorId != request.auth.uid));
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == resource.data.postId
        && interactionId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'liked', 'saved', 'readAt', 'updatedAt'
        ])
        && (!('liked' in request.resource.data) || request.resource.data.liked is bool)
        && (!('saved' in request.resource.data) || request.resource.data.saved is bool)
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt'])
          || (!('readAt' in resource.data)
            && request.resource.data.readAt == request.time
            && get(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId)).data.authorId != request.auth.uid));
    }

    match /analytics_daily/{dateKey} {
      allow read: if hasPortalAccess();
      allow write: if false;
      match /users/{userId} {
        allow read: if hasPortalAccess();
        allow write: if false;
      }
    }

    match /_analytics_events/{eventId} {
      allow read, write: if false;
    }

    match /secret_chat_profiles/{userId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create, update, delete: if false;
    }

    match /secret_chat_aliases/{aliasKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /secret_chat_profile_stats/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /_secret_chat_events/{eventId} {
      allow read, write: if false;
    }

    match /appointments/{appointmentId} {
      // Appointment mutations are callable-only.  This prevents a student
      // from confirming/completing their own record or bypassing slot locks.
      allow create: if false;
      allow read: if isOwner(resource.data.userId)
        || currentAccessRole() == 'portalStaff'
        || currentAccessRole() == 'admin'
        || (currentAccessRole() == 'counselor'
          && resource.data.assignedStaffId == request.auth.uid);
      allow update, delete: if false;
      match /history/{historyId} {
        allow read: if isOwner(get(/databases/$(database)/documents/appointments/$(appointmentId)).data.userId)
          || currentAccessRole() == 'portalStaff'
          || currentAccessRole() == 'admin'
          || (currentAccessRole() == 'counselor'
            && get(/databases/$(database)/documents/appointments/$(appointmentId)).data.assignedStaffId == request.auth.uid);
        allow write: if false;
      }
    }

    match /notifications/{notificationId} {
      // Notifications are per-recipient. Clinical access must not expose
      // notification text sent to other users.
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && resource.data.readAt == null
        && request.resource.data.readAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }

    match /user_devices/{userId}/tokens/{tokenId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    match /inquiries/{inquiryId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'message', 'category', 'email', 'name',
          'role', 'formType', 'formData', 'status', 'createdAt'
        ])
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read: if isOwner(resource.data.userId) || hasPortalAccess();
      allow update: if hasPortalAccess()
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /appointment_slots/{slotId} {
      allow read, write: if false;
    }

    match /pacc_availability/{documentId} {
      allow read: if signedIn();
      allow create, update: if hasPortalAccess();
      allow delete: if false;
    }

    match /insight_categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isPortalAdmin();
    }

    match /insight_content/{contentId} {
      allow read: if signedIn();
      allow write: if isPortalAdmin();
    }

    match /insight_rules/{ruleId} {
      allow read: if signedIn();
      allow write: if isPortalAdmin();
    }

    match /recommendations/{recommendationId} {
      allow read: if signedIn();
      allow write: if isSystemAdmin();
    }


    match /role_correction_requests/{requestId} {
      allow read: if isOwner(resource.data.userId) || hasPortalAccess();
      allow create, update, delete: if false;
    }

    match /role_audit_logs/{auditId} {
      allow read: if isSystemAdmin();
      allow write: if false;
    }
  }
}

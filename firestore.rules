rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A student on the temporary password carries firstLoginPending and may only read their own profile
    // until completeStudentPasswordChange clears it, so every rule built on signedIn()/isOwner() excludes them.
    function signedIn() {
      return request.auth != null && request.auth.token.get("firstLoginPending", false) != true;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function currentAccessRole() {
      return !signedIn() || !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? 'appUser'
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessRole != null
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessRole
          : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function portalProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Portal access = portal role + verified email + account lifecycle.
    // Mirrors functions/src/access.ts::requireStaff.
    //  - `accountStatus`: absent means a pre-lifecycle (legacy) record and is
    //    treated as active; any explicit non-active value (suspended,
    //    disabled, pending) denies, including for administrators.
    //  - `staffAccountStatus`: absent means legacy; otherwise it must be
    //    'approved'. Administrators are not applicant requests.
    // Fields are read with get() so a missing key is "legacy", not an
    // evaluation error that silently denies the whole request.
    function hasPortalAccess() {
      return currentAccessRole() in ['portalStaff', 'counselor', 'admin']
        && isVerifiedEmail()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && portalProfile().get('accountStatus', 'active') == 'active'
        && (
          currentAccessRole() == 'admin'
          || portalProfile().get('staffAccountStatus', null) == null
          || portalProfile().get('staffAccountStatus', null) == 'approved'
        );
    }

    // Clinical reads mirror the server-side `requireClinical` gate: the role
    // alone is not enough, the account must also pass the staff lifecycle
    // (approved, active, verified email). A suspended or unverified record
    // that still carries the role string must not read care data.
    function hasClinicalAccess() {
      return currentAccessRole() in ['counselor', 'admin'] && hasPortalAccess();
    }

    function isAdmin() {
      return hasClinicalAccess();
    }

    // Clinical staff may review care data, but only administrator accounts
    // may change portal configuration and curated content.
    function isPortalAdmin() {
      return currentAccessRole() == 'admin' && hasPortalAccess();
    }

    function isSystemAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/system_config/security)
        && request.auth.uid == get(/databases/$(database)/documents/system_config/security).data.superAdminUid
        && currentAccessRole() == 'admin'
        && hasPortalAccess();
    }

    function validSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'firstName', 'middleName', 'lastName', 'phone', 'avatarAssetName',
        'profilePhotoUrl', 'profilePhotoPath', 'profileSetupCompleted',
        'updatedAt', 'lastActiveAt', 'lastActivityDateKey', 'activeDateKeys',
        'streakUpdatedAt', 'dayStreak', 'longestStreak',
        'quickAssessmentCompleted', 'quickAssessmentCompletedAt',
        'lastMoodDateKey'
      ])
      && (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['profileSetupCompleted'])
          || request.resource.data.profileSetupCompleted == true);
    }

    function isLegacyPrivileged() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'counselor'];
    }

    match /users/{userId} {
      // New profiles must be created by the Admin SDK callable so Student ID
      // reservation and profile creation remain one atomic transaction.
      // College assignments (assignedCollegeIds, collegeAssignment*) are
      // written only by the setStaffCollegeAssignments callable; they are
      // deliberately absent from validSelfProfileUpdate's allow-list.
      allow create: if false;
      allow read: if (request.auth != null && request.auth.uid == userId) || isSystemAdmin();
      allow update: if (isOwner(userId) && validSelfProfileUpdate());
      allow delete: if isSystemAdmin();
    }

    function announcementReader() {
      return isVerifiedEmail()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'active') == 'active';
    }
    function announcementPublisher() {
      return announcementReader()
        && currentAccessRole() in ['portalStaff', 'admin']
        && (currentAccessRole() == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('staffAccountStatus', 'approved') == 'approved');
    }
    match /announcements/{postId} {
      allow read: if announcementPublisher()
        || (announcementReader() && resource.data.status == 'published');
      allow write: if false;
    }
    match /system_config/{documentId} {
      // inquiry_sla holds the super-admin's response target (hours); it is set
      // only by the setInquirySla callable.
      allow read: if signedIn()
        && (documentId == 'security'
          || (documentId == 'inquiry_sla' && hasPortalAccess()));
      allow write: if false;
    }

    match /colleges/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /departments/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /courses/{recordId} {
      allow read: if true;
      allow write: if false;
    }

    match /employee_id_reservations/{recordId} {
      allow read, write: if false;
    }

    match /student_id_reservations/{recordId} {
      allow read, write: if false;
    }

    // Roster data is Admin-SDK only. Students may read just their own
    // personal-information record and correction requests; all writes go
    // through callables.
    match /student_roster/{id} {
      allow read, write: if false;
    }

    match /student_roster_imports/{id} {
      allow read, write: if false;
    }

    match /student_activation_attempts/{id} {
      allow read, write: if false;
    }

    match /student_personal_info/{userId} {
      allow get: if isOwner(userId);
      allow list, write: if false;
    }

    match /student_correction_requests/{id} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Recovery markers are internal Cloud Functions state. Clients must never
    // create one to authorize an otherwise ambiguous account deletion retry.
    match /pending_registration_cancellations/{userId} {
      allow read, write: if false;
    }

    match /admin_audit_logs/{auditId} {
      allow read: if isSystemAdmin();
      allow write: if false;
    }

    // Firestore managed-export job records. Written only by Cloud Functions;
    // readable only by the configured super-administrator. They hold status,
    // timestamps, counts and sanitised error codes, never document contents.
    match /backup_jobs/{jobId} {
      allow read: if isSystemAdmin();
      allow write: if false;
    }

    match /user_public_ids/{userId} {
      allow read, write: if false;
    }

    match /public_user_id_reservations/{publicId} {
      allow read, write: if false;
    }

    match /assessments/{assessmentId} {
      allow create: if isVerifiedEmail() && isOwner(request.resource.data.userId)
        && (!request.resource.data.keys().hasAny(['schemaVersion'])
          || request.resource.data.schemaVersion != 'assessment_record_v4')
        && (request.resource.data.type != 'quick'
          || assessmentId == 'quick_' + request.auth.uid);
      allow get: if (signedIn()
          && assessmentId == 'quick_' + request.auth.uid)
        || isOwner(resource.data.userId)
        || isAdmin();
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin()
        || (isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && resource.data.type != 'quick'
          && (!resource.data.keys().hasAny(['schemaVersion'])
            || resource.data.schemaVersion != 'assessment_record_v4'));
    }

    match /assessment_feedback/{feedbackId} {
      allow create: if isVerifiedEmail() && signedIn()
        && request.resource.data.keys().hasOnly([
          'clarity', 'algorithmVersion', 'questionSetVersion', 'createdAt'
        ])
        && request.resource.data.clarity in ['clear', 'partlyClear', 'unclear']
        && request.resource.data.algorithmVersion is string
        && request.resource.data.questionSetVersion is string
        && request.resource.data.createdAt == request.time;
      allow read: if hasPortalAccess();
      allow update, delete: if false;
    }

    match /moods/{moodId} {
      allow create: if isOwner(request.resource.data.userId)
        && moodId.matches('^daily_' + request.auth.uid + '_[0-9]{8}$')
        && request.resource.data.keys().hasOnly([
          'userId', 'level', 'label', 'note', 'dateKey', 'timezone', 'createdAt',
          'entryMethod', 'expressionAssistUsed', 'expressionSuggestionAccepted',
          'expressionModelVersion'
        ])
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 5
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 40
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.timezone == 'Asia/Manila'
        && request.resource.data.createdAt == request.time
        && ((!request.resource.data.keys().hasAny([
              'entryMethod', 'expressionAssistUsed',
              'expressionSuggestionAccepted', 'expressionModelVersion'
            ]))
          || (request.resource.data.keys().hasAll([
                'entryMethod', 'expressionAssistUsed',
                'expressionSuggestionAccepted'
              ])
            && request.resource.data.entryMethod == 'expression_assisted'
            && request.resource.data.expressionAssistUsed == true
            && request.resource.data.expressionSuggestionAccepted is bool
            && (!request.resource.data.keys().hasAny(['expressionModelVersion'])
              || request.resource.data.expressionModelVersion
                == 'justinshenk_fer_tflite_v1')));
      allow get: if (signedIn()
          && moodId.matches('^daily_' + request.auth.uid + '_[0-9]{8}$'))
        || isOwner(resource.data.userId)
        || isAdmin();
      allow list: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin()
        || (isOwner(resource.data.userId)
          && resource.data.timezone != 'Asia/Manila');
    }

    // Mood V2 is written solely through its authenticated callable. This
    // keeps the server instant, Manila date key, and idempotency transaction
    // authoritative. Broader staff/admin reads are deliberately out of scope.
    match /moodEntries/{entryId} {
      allow get, list: if isOwner(resource.data.userId);
      allow create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isAdmin()
        || (isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId);
    }

    match /admin_status_summaries/{userId} {
      allow read: if isAdmin();
      allow create, update: if isOwner(request.resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /user_activities/{activityId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      allow update: if (isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId) || isAdmin();
    }

    match /breathing_sessions/{sessionId} {
      allow create: if isOwner(request.resource.data.userId);
      allow read, delete: if isOwner(resource.data.userId) || isAdmin();
      allow update: if (isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId) || isAdmin();
    }


    // Human counseling conversations are separate from MindAid AI history.
    // Only approved, email-verified counselor accounts may access the inbox.
    function isApprovedCounselor() {
      return signedIn() && isVerifiedEmail()
        && currentAccessRole() == 'counselor'
        && hasPortalAccess();
    }

    // App users answer counselors only with these exact texts: the quick
    // replies, then the PACC service inquiry templates. Must equal
    // guidanceStudentMessageTexts in lib/features/counseling/data/guidance_quick_replies.dart.
    function guidanceStudentMessageTexts() {
      return [
        'I understand.',
        'Noted.',
        'Thank you for your guidance.',
        'I need clarification.',
        'I am available.',
        'I am not available.',
        'I would like a follow-up session.',
        'I need further assistance.',
        'My concern has been addressed.',
        'Good day! I would like to inquire about Information Service, specifically the Personal Field. May I ask what information and assistance PACC provides regarding personal concerns? Thank you!',
        'Good day! I would like to inquire about Information Service, specifically the Psychological Field. May I ask what information and guidance PACC provides in this area? Thank you!',
        'Good day! I would like to inquire about Information Service, specifically the Social Field. May I ask what information and support PACC provides regarding social adjustment and relationships? Thank you!',
        'Good day! I would like to inquire about Information Service, specifically the Educational Field. May I ask what educational information and guidance are available to students? Thank you!',
        'Good day! I would like to inquire about Information Service, specifically the Vocational Field. May I ask what vocational information and guidance PACC provides? Thank you!',
        'Good day! I would like to inquire about Information Service, specifically General Inquiry. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Individual Inventory Service, specifically Student Records. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Individual Inventory Service, specifically Interview Requirements. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Individual Inventory Service, specifically Required Forms. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Individual Inventory Service, specifically Consent to Release Information. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Individual Inventory Service, specifically General Inquiry. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Testing Service, specifically Testing Process. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Testing Service, specifically Testing Schedule. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Testing Service, specifically Requirements. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Testing Service, specifically Test Report. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Testing Service, specifically General Inquiry. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Counseling Service, specifically Counseling Process. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Counseling Service, specifically Appointment Inquiry. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Counseling Service, specifically General Inquiry. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Follow-up Service, specifically Follow-up Process. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Follow-up Service, specifically Adding, Changing & Dropping Subjects. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Follow-up Service, specifically Shifting of Course. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Follow-up Service, specifically General Inquiry. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Career Guidance and Placement Service, specifically Career Planning. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Career Guidance and Placement Service, specifically Placement Assistance. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Career Guidance and Placement Service, specifically Signing of Clearance for Graduation. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Career Guidance and Placement Service, specifically General Inquiry. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Referral Service, specifically Referral Process. May I ask PACC for information and guidance about this topic? Thank you!',
        'Good day! I would like to inquire about Referral Service, specifically General Inquiry. May I ask PACC for information and guidance about this topic? Thank you!'
      ];
    }

    function registeredCounselorName(userId) {
      let profile = get(/databases/$(database)/documents/users/$(userId)).data;
      let first = profile.get('firstName', '');
      let middle = profile.get('middleName', '');
      let last = profile.get('lastName', '');
      return profile.get('name', '') == request.resource.data.studentName
        || (first + ' ' + last) == request.resource.data.studentName
        || (middle != '' && (first + ' ' + middle + ' ' + last) == request.resource.data.studentName);
    }

    // A badge timestamp must be tied to a NEW message in the same atomic batch.
    function linkedCounselorMessage(userId, messageId, senderId, senderRole) {
      return messageId is string
        && messageId.size() > 0 && messageId.size() <= 160
        && !exists(/databases/$(database)/documents/counselor_threads/$(userId)/messages/$(messageId))
        && existsAfter(/databases/$(database)/documents/counselor_threads/$(userId)/messages/$(messageId))
        && getAfter(/databases/$(database)/documents/counselor_threads/$(userId)/messages/$(messageId)).data.senderId == senderId
        && getAfter(/databases/$(database)/documents/counselor_threads/$(userId)/messages/$(messageId)).data.senderRole == senderRole
        && getAfter(/databases/$(database)/documents/counselor_threads/$(userId)/messages/$(messageId)).data.createdAt == request.time;
    }

    // Per-counselor read receipts prevent one counselor clearing another's badge.
    match /counselor_inbox_reads/{counselorUid}/threads/{studentId} {
      allow read: if isApprovedCounselor() && request.auth.uid == counselorUid;
      allow create, update: if isApprovedCounselor()
        && request.auth.uid == counselorUid
        && exists(/databases/$(database)/documents/counselor_threads/$(studentId))
        && request.resource.data.keys().hasOnly(['readAt', 'readThrough'])
        && request.resource.data.readAt == request.time
        && (!('readThrough' in request.resource.data) || (
          request.resource.data.readThrough is timestamp
          && request.resource.data.readThrough <= request.time
        ));
      allow delete: if false;
    }

    match /counselor_threads/{userId} {
      allow get, list: if isOwner(userId) || isApprovedCounselor();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['userId', 'collegeId', 'updatedAt', 'studentName', 'lastStudentMessageAt', 'lastStudentMessageId'])
        && request.resource.data.userId == userId
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.collegeId is string
        && request.resource.data.collegeId ==
          get(/databases/$(database)/documents/users/$(userId)).data.collegeId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastStudentMessageAt == request.time
        && linkedCounselorMessage(userId, request.resource.data.lastStudentMessageId, userId, 'user')
        && (!request.resource.data.keys().hasAny(['studentName'])
          || (request.resource.data.studentName is string
            && request.resource.data.studentName.size() <= 160
            && registeredCounselorName(userId)));
      allow update: if (isOwner(userId) || isApprovedCounselor())
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && request.resource.data.collegeId == resource.data.collegeId
        && (
          (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['updatedAt', 'lastStudentMessageAt', 'lastStudentMessageId', 'studentName', 'studentReadAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt', 'lastStudentMessageAt', 'lastStudentMessageId'])
              || (request.resource.data.updatedAt == request.time
                && request.resource.data.lastStudentMessageAt == request.time
                && request.resource.data.lastStudentMessageId != resource.data.get('lastStudentMessageId', '')
                && linkedCounselorMessage(userId, request.resource.data.lastStudentMessageId, userId, 'user')))
            // The latest counselor message the student has seen (the counselor's Read).
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentReadAt'])
              || (request.resource.data.studentReadAt is timestamp
                && request.resource.data.studentReadAt <= request.time))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentName'])
              || (request.resource.data.studentName is string
                && request.resource.data.studentName.size() <= 160
                && registeredCounselorName(userId))))
          || (isApprovedCounselor()
            && request.resource.data.diff(resource.data).affectedKeys().size() > 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['updatedAt', 'lastCounselorMessageAt', 'lastCounselorMessageId', 'counselorReadAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(
                ['updatedAt', 'lastCounselorMessageAt', 'lastCounselorMessageId'])
              || (request.resource.data.updatedAt == request.time
                && request.resource.data.lastCounselorMessageAt == request.time
                && request.resource.data.lastCounselorMessageId != resource.data.get('lastCounselorMessageId', '')
                && linkedCounselorMessage(userId, request.resource.data.lastCounselorMessageId, request.auth.uid, 'counselor')))
            // The latest student message a counselor has seen (the student's Read).
            // Never in the future and never moving backwards.
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['counselorReadAt'])
              || (request.resource.data.counselorReadAt is timestamp
                && request.resource.data.counselorReadAt <= request.time
                && (!('counselorReadAt' in resource.data)
                  || request.resource.data.counselorReadAt >= resource.data.counselorReadAt))))
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOwner(userId) || isApprovedCounselor();
        allow create: if (isOwner(userId) || isApprovedCounselor())
          && existsAfter(/databases/$(database)/documents/counselor_threads/$(userId))
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isOwner(userId) ? 'user' : 'counselor')
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1600
          // Counselors write free text; the thread's own user only a quick reply.
          && (!isOwner(userId) || request.resource.data.text in guidanceStudentMessageTexts())
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /mind_aid_messages/{messageId} {
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.sender in ['user', 'assistant']
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1600
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() <= 64
        && request.resource.data.id == messageId
        && request.resource.data.status is string
        && request.resource.data.status.size() <= 24
        && request.resource.data.source is string
        && request.resource.data.source in ['local', 'dialogflow', 'controlled_safety']
        && request.resource.data.confidence is number
        && request.resource.data.confidence >= 0
        && request.resource.data.confidence <= 1
        && (request.resource.data.sender == 'user'
          || request.resource.data.source == 'local');
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && resource.data.sender == 'assistant'
        && resource.data.requiresEscalation == false
        && resource.data.safetyLevel == 'safeSupport'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paaccDisplay'])
        && request.resource.data.paaccDisplay is map
        && request.resource.data.paaccDisplay.keys().hasOnly(['text', 'actions'])
        && request.resource.data.paaccDisplay.text is string
        && request.resource.data.paaccDisplay.text.size() >= 1
        && request.resource.data.paaccDisplay.text.size() <= 600
        && request.resource.data.paaccDisplay.actions is list
        && request.resource.data.paaccDisplay.actions.size() <= 1
        && (request.resource.data.paaccDisplay.actions.size() == 0 ||
          (request.resource.data.paaccDisplay.actions[0] is map
            && request.resource.data.paaccDisplay.actions[0].keys().hasOnly(['type', 'label', 'payload'])
            && request.resource.data.paaccDisplay.actions[0].type in [
              'bookAppointment', 'viewAppointments', 'openAssessment', 'openCounselingServices', 'startBreathing'
            ]
            && request.resource.data.paaccDisplay.actions[0].label is string
            && request.resource.data.paaccDisplay.actions[0].label.size() <= 80
            && request.resource.data.paaccDisplay.actions[0].payload == {}));
    }

    match /mind_aid_dialogue_state/{userId}/conversations/{conversationId} {
      function validDialogueState() {
        return request.resource.data.keys().hasOnly(['userId', 'conversationId', 'pending', 'updatedAt'])
          && request.resource.data.userId == userId
          && request.resource.data.conversationId == conversationId
          && conversationId.size() >= 1
          && conversationId.size() <= 64
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.pending == null ||
            (request.resource.data.pending is map
              && request.resource.data.pending.keys().hasOnly(['sourceMessageId', 'action', 'expiresAt'])
              && request.resource.data.pending.sourceMessageId is string
              && request.resource.data.pending.sourceMessageId.size() <= 128
              && request.resource.data.pending.expiresAt is timestamp
              && request.resource.data.pending.expiresAt <= request.time + duration.value(11, 'm')
              && get(/databases/$(database)/documents/mind_aid_messages/$(request.resource.data.pending.sourceMessageId)).data.userId == userId
              && get(/databases/$(database)/documents/mind_aid_messages/$(request.resource.data.pending.sourceMessageId)).data.conversationId == conversationId
              && get(/databases/$(database)/documents/mind_aid_messages/$(request.resource.data.pending.sourceMessageId)).data.sender == 'assistant'
              && get(/databases/$(database)/documents/mind_aid_messages/$(request.resource.data.pending.sourceMessageId)).data.requiresEscalation == false
              && get(/databases/$(database)/documents/mind_aid_messages/$(request.resource.data.pending.sourceMessageId)).data.safetyLevel in ['safeSupport', 'needsClarification']
              && request.resource.data.pending.action is map
              && request.resource.data.pending.action.keys().hasOnly(['type', 'label', 'payload'])
              && request.resource.data.pending.action.type in [
                'bookAppointment', 'viewAppointments', 'openAssessment', 'openCounselingServices', 'startBreathing'
              ]
              && request.resource.data.pending.action.label is string
              && request.resource.data.pending.action.label.size() <= 80
              && request.resource.data.pending.action.payload == {}));
      }
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validDialogueState();
      allow update: if isOwner(userId)
        && validDialogueState()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.conversationId == resource.data.conversationId;
      allow delete: if isOwner(userId);
    }

    function validSleepTags(data) {
      return data.contributorTags is list
        && data.contributorTags.size() <= 12
        && data.contributorTags.toSet().size() == data.contributorTags.size()
        && data.contributorTags.toSet().hasOnly([
          'late_caffeine', 'alcohol', 'nicotine', 'naps', 'exercise',
          'late_screens', 'stress', 'environment', 'late_meal',
          'schedule_change', 'illness_pain', 'medication'
        ])
        && data.concernTags is list
        && data.concernTags.size() <= 5
        && data.concernTags.toSet().size() == data.concernTags.size()
        && data.concernTags.toSet().hasOnly([
          'breathing_pauses_gasping', 'loud_snoring_tiredness',
          'dangerous_sleepiness', 'persistent_problems', 'worsening_symptoms'
        ]);
    }

    function validSleepEntry(data) {
      return data.keys().hasOnly([
          'userId', 'wakeDateKey', 'timezone', 'attemptedSleepAt',
          'sleepOnsetAt', 'finalWakeAt', 'outOfBedAt', 'awakeningCount',
          'awakeMinutes', 'napCount', 'napMinutes', 'restfulness',
          'daytimeSleepiness', 'perceivedQuality', 'contributorTags',
          'concernTags', 'createdAt', 'clientUpdatedAt', 'updatedAt'
        ])
        && data.wakeDateKey is string
        && data.wakeDateKey.matches('^[0-9]{8}$')
        && data.timezone == 'Asia/Manila'
        && data.attemptedSleepAt is timestamp
        && data.sleepOnsetAt is timestamp
        && data.finalWakeAt is timestamp
        && data.outOfBedAt is timestamp
        && data.attemptedSleepAt <= data.sleepOnsetAt
        && data.sleepOnsetAt <= data.finalWakeAt
        && data.finalWakeAt <= data.outOfBedAt
        && data.awakeningCount is int
        && data.awakeningCount >= 0 && data.awakeningCount <= 50
        && data.awakeMinutes is int
        && data.awakeMinutes >= 0 && data.awakeMinutes <= 1440
        && ((data.awakeningCount == 0 && data.awakeMinutes == 0)
          || (data.awakeningCount > 0 && data.awakeMinutes > 0))
        && data.napCount is int && data.napCount >= 0 && data.napCount <= 10
        && data.napMinutes is int && data.napMinutes >= 0 && data.napMinutes <= 720
        && data.restfulness is int && data.restfulness >= 1 && data.restfulness <= 5
        && data.daytimeSleepiness is int
        && data.daytimeSleepiness >= 1 && data.daytimeSleepiness <= 5
        && data.perceivedQuality is int
        && data.perceivedQuality >= 1 && data.perceivedQuality <= 5
        && data.createdAt is timestamp
        && data.clientUpdatedAt is timestamp
        && data.updatedAt == request.time
        && validSleepTags(data);
    }

    match /sleep_entries/{sleepId} {
      allow create: if isOwner(request.resource.data.userId)
        && sleepId == 'sleep_' + request.auth.uid + '_' + request.resource.data.wakeDateKey
        && validSleepEntry(request.resource.data);
      allow get, list: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.wakeDateKey == resource.data.wakeDateKey
        && request.resource.data.createdAt == resource.data.createdAt
        && sleepId == 'sleep_' + request.auth.uid + '_' + request.resource.data.wakeDateKey
        && validSleepEntry(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /sleep_preferences/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'userId', 'consentVersion', 'cloudConsent', 'grantedAt', 'updatedAt'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.consentVersion == 'sleep-v1'
        && request.resource.data.cloudConsent == true
        && request.resource.data.grantedAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    match /mind_aid_preferences/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.hasDecision is bool
        && request.resource.data.cloudConsent is bool
        && request.resource.data.personalizationEnabled is bool
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() >= 8
        && request.resource.data.conversationId.size() <= 64;
      allow delete: if isOwner(userId);
    }

    match /mind_aid_feedback/{feedbackId} {
      allow create, update: if isOwner(request.resource.data.userId)
        && request.resource.data.messageId is string
        && request.resource.data.helpful is bool;
      allow read, delete: if isOwner(resource.data.userId);
    }

    match /mind_aid_analytics_daily/{dateKey} {
      allow read: if hasPortalAccess();
      allow write: if false;
    }

    match /mind_aid_config/{documentId} {
      allow read, write: if isPortalAdmin();
    }

    match /_mind_aid_events/{eventId} {
      allow read, write: if false;
    }

    match /_mind_aid_rate_limits/{userId} {
      allow read, write: if false;
    }

    // Forum text is published only by the moderated createSecretChatPost and
    // addSecretChatComment callables. Staff may change moderation status, but no
    // role may rewrite published text.
    function forumModerationUpdate() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['moderationStatus', 'safetyLabels', 'updatedAt'])
        && request.resource.data.moderationStatus is string;
    }

    match /secret_chats/{postId} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isAdmin());
      allow create: if false;
      allow update: if forumModerationUpdate();
      allow delete: if isAdmin();
    }

    match /secret_chat_comments/{commentId} {
      allow read: if signedIn()
        && (resource.data.moderationStatus == 'active' || isAdmin());
      allow create: if false;
      allow update: if forumModerationUpdate();
      allow delete: if isAdmin()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /secret_chat_interactions/{interactionId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && interactionId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'liked', 'saved', 'readAt', 'updatedAt'
        ])
        && (!('liked' in request.resource.data) || request.resource.data.liked is bool)
        && (!('saved' in request.resource.data) || request.resource.data.saved is bool)
        && request.resource.data.updatedAt == request.time
        && exists(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId))
        && (!('readAt' in request.resource.data)
          || (request.resource.data.readAt == request.time
            && get(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId)).data.authorId != request.auth.uid));
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId == resource.data.postId
        && interactionId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.keys().hasOnly([
          'userId', 'postId', 'liked', 'saved', 'readAt', 'updatedAt'
        ])
        && (!('liked' in request.resource.data) || request.resource.data.liked is bool)
        && (!('saved' in request.resource.data) || request.resource.data.saved is bool)
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt'])
          || (!('readAt' in resource.data)
            && request.resource.data.readAt == request.time
            && get(/databases/$(database)/documents/secret_chats/$(request.resource.data.postId)).data.authorId != request.auth.uid));
    }

    match /analytics_daily/{dateKey} {
      allow read: if hasPortalAccess();
      allow write: if false;
      match /users/{userId} {
        allow read: if hasPortalAccess();
        allow write: if false;
      }
    }

    match /_analytics_events/{eventId} {
      allow read, write: if false;
    }

    match /secret_chat_profiles/{userId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create, update, delete: if false;
    }

    match /secret_chat_aliases/{aliasKey} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /secret_chat_profile_stats/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /_secret_chat_events/{eventId} {
      allow read, write: if false;
    }

    function isAssignedCollegeCounselorForAppointmentData(data) {
      return currentAccessRole() == 'counselor'
        && hasClinicalAccess()
        && data.studentVerificationStatus == 'verified'
        && data.collegeId is string
        && data.collegeId != ''
        && data.collegeId in portalProfile().get('assignedCollegeIds', []);
    }

    function isLiveAssignedCollegeCounselorForStudent(studentId) {
      return currentAccessRole() == 'counselor'
        && hasClinicalAccess()
        && studentId is string
        && studentId != ''
        && exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.get('verificationStatus', '') == 'verified'
        && get(/databases/$(database)/documents/users/$(studentId)).data.get('collegeId', '') is string
        && get(/databases/$(database)/documents/users/$(studentId)).data.get('collegeId', '') != ''
        && get(/databases/$(database)/documents/users/$(studentId)).data.get('collegeId', '') in portalProfile().get('assignedCollegeIds', []);
    }

    match /appointments/{appointmentId} {
      // Appointment mutations are callable-only.  This prevents a student
      // from confirming/completing their own record or bypassing slot locks.
      allow create: if false;
      allow get: if isOwner(resource.data.userId)
        || isSystemAdmin()
        || isLiveAssignedCollegeCounselorForStudent(resource.data.userId);
      allow list: if isOwner(resource.data.userId)
        || isSystemAdmin()
        || isAssignedCollegeCounselorForAppointmentData(resource.data);
      allow update, delete: if false;
      match /history/{historyId} {
        allow read: if isOwner(get(/databases/$(database)/documents/appointments/$(appointmentId)).data.userId)
          || isSystemAdmin()
          || isLiveAssignedCollegeCounselorForStudent(get(/databases/$(database)/documents/appointments/$(appointmentId)).data.userId);
        allow write: if false;
      }
      match /clinical_notes/{noteId} {
        allow read: if isSystemAdmin()
          || isLiveAssignedCollegeCounselorForStudent(get(/databases/$(database)/documents/appointments/$(appointmentId)).data.userId);
        allow write: if false;
      }
    }

    // This is a server-generated, non-clinical scheduling projection. It is
    // the only appointment collection general PACC portal staff can read.
    match /appointment_queue/{appointmentId} {
      // Role alone is not enough: a suspended or unverified staff record can
      // still carry the `portalStaff` string, so the lifecycle gates apply.
      allow read: if currentAccessRole() == 'portalStaff' && hasPortalAccess();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      // Notifications are per-recipient. Clinical access must not expose
      // notification text sent to other users.
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && resource.data.readAt == null
        && request.resource.data.readAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow create, delete: if false;
    }

    // A minimal, server-created safety incident record. It deliberately has
    // no chat transcript. General portal staff cannot read emergency alerts.
    match /mind_aid_emergency_alerts/{alertId} {
      allow read: if hasClinicalAccess();
      allow create, update, delete: if false;
    }

    match /_mind_aid_active_emergency_alerts/{userId} {
      allow read, write: if false;
    }

    match /user_devices/{userId}/tokens/{tokenId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId);
    }

    match /inquiries/{inquiryId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'subject', 'message', 'category', 'email', 'name',
          'role', 'formType', 'formData', 'status', 'createdAt'
        ])
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 1
        && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      // Raw inquiry documents carry student PII, messages and form responses.
      // Read access is restricted strictly by `canReadInquiry`:
      // 1) the owning student,
      // 2) the verified, active configured super-administrator, and
      // 3) an active, approved, verified counselor explicitly assigned to it
      //    (`assigneeIds`, written only by Cloud Functions).
      // Operational `portalStaff` must NEVER read raw inquiries or replies,
      // even if their UID appears in a legacy `assigneeIds` array; they read
      // sanitized operational projections under `inquiry_statuses/{inquiryId}`.
      allow read: if canReadInquiry(resource.data);
      // Acknowledge, status, escalation and reassignment are audited
      // callables (functions/src/inquiry_routing_service.ts).
      allow update, delete: if false;

      // Authored replies follow their inquiry's clinical visibility and are
      // written only by the replyToInquiry callable.
      match /replies/{replyId} {
        allow read: if canReadInquiry(get(/databases/$(database)/documents/inquiries/$(inquiryId)).data);
        allow write: if false;
      }
    }

    function canReadInquiry(inquiry) {
      return isOwner(inquiry.userId)
        || isSystemAdmin()
        || (currentAccessRole() == 'counselor'
          && hasClinicalAccess()
          && request.auth.uid in inquiry.get('assigneeIds', []));
    }

    // Server-managed, staff-safe operational status projection for inquiries.
    // Excludes student UID, email, name, message, user-authored subject,
    // formData and free-text escalation reasons.
    match /inquiry_statuses/{inquiryId} {
      allow read: if isSystemAdmin()
        || (currentAccessRole() == 'portalStaff'
          && hasPortalAccess()
          && request.auth.uid in resource.data.get('monitoringStaffIds', []))
        || (currentAccessRole() == 'counselor'
          && hasClinicalAccess()
          && request.auth.uid in resource.data.get('assigneeIds', []));
      allow write: if false;
    }

    match /appointment_slots/{slotId} {
      allow read, write: if false;
    }

    match /pacc_availability/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /insight_categories/{categoryId} {
      allow read: if signedIn();
      allow write: if isPortalAdmin();
    }

    match /insight_content/{contentId} {
      allow read: if signedIn();
      allow write: if isPortalAdmin();
    }

    match /insight_rules/{ruleId} {
      allow read: if signedIn();
      allow write: if isPortalAdmin();
    }

    match /recommendations/{recommendationId} {
      allow read: if signedIn();
      allow write: if isSystemAdmin();
    }


    match /role_correction_requests/{requestId} {
      allow read: if isOwner(resource.data.userId) || hasPortalAccess();
      allow create, update, delete: if false;
    }

    match /role_audit_logs/{auditId} {
      allow read: if isSystemAdmin();
      allow write: if false;
    }
  }
}
